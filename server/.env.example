# XAMPP MySQL connection (default XAMPP root user has an empty password)
# If you set a MySQL password, use it after root: and URL-encode special characters.
DATABASE_URL="mysql://root:@localhost:3306/farmdirect"

# JWT Authentication Secret (replace for production)
JWT_SECRET="replace-with-a-long-random-secret-at-least-16-chars"
JWT_EXPIRES_IN="7d"

# Frontend Application URL
CLIENT_URL="http://localhost:5173"

# Backend server
PORT=5000
NODE_ENV="development"

# Optional AI provider API key
AI_API_KEY=""
